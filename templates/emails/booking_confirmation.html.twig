{# templates/emails/booking_confirmation.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Confirmation de réservation</title>
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
    <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
        <h1 style="color: #2563eb;">Confirmation de réservation</h1>
        
        <p>Bonjour {{ booking.customer.firstName }} {{ booking.customer.lastName }},</p>
        
        <p>Votre réservation a été confirmée avec succès !</p>
        
        <div style="background: #f3f4f6; padding: 20px; border-radius: 8px; margin: 20px 0;">
            <h2 style="margin-top: 0;">Détails de la réservation</h2>
            
            <p><strong>Numéro de réservation :</strong> {{ booking.bookingNumber }}</p>
            <p><strong>Voiture :</strong> {{ booking.car.brand }} {{ booking.car.model }}</p>
            <p><strong>Lieu de prise en charge :</strong> {{ booking.pickupPoint.name }}</p>
            <p><strong>Date de début :</strong> {{ booking.startDate|date('d/m/Y à H:i') }}</p>
            <p><strong>Date de fin :</strong> {{ booking.endDate|date('d/m/Y à H:i') }}</p>
            <p><strong>Durée :</strong> {{ booking.numberOfDays }} jour(s)</p>
            <p><strong>Prix total :</strong> {{ booking.totalPrice }} MAD</p>
        </div>
        
        <p>Merci d'avoir choisi nos services !</p>
        
        <p style="font-size: 12px; color: #666; margin-top: 40px;">
            Cet email a été envoyé automatiquement, merci de ne pas y répondre.
        </p>
    </div>
</body>
</html>